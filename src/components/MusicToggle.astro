---
// ingen import nødvendigt for filer i public/
---

<button
  id="music-btn"
  class="w-8 h-8 cursor-pointer"
  aria-label="Toggle music"
  aria-pressed="false"
  data-on="/music-on.svg"
  data-off="/music-off.svg"
>
  <img src="/music-on.svg" alt="Music on" class="w-full h-full" />
</button>

<audio id="bg-music" src="https://assets.mixkit.co/music/preview/mixkit-ambient-technology-183.mp3" loop preload="none"></audio>


<script>
  const btn = document.getElementById("music-btn");
  const img = btn.querySelector("img");
  const audio = document.getElementById("bg-music");

  let playing = false;

  btn.addEventListener("click", async () => {
    playing = !playing;
    btn.setAttribute("aria-pressed", String(playing));

    if (playing) {
      try {
        await audio.play(); // user interaction required — OK ved klik
        img.src = btn.dataset.on;
      } catch (err) {
        console.warn("Kunne ikke starte afspilning:", err);
        playing = false;
        btn.setAttribute("aria-pressed", "false");
      }
    } else {
      audio.pause();
      img.src = btn.dataset.off;
    }
  });
</script>

<style>
  button:hover img {
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }
</style>

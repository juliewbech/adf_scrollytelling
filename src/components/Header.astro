---
import Button from "../components/Button.astro";
import MusicToggle from "./MusicToggle.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
---
<header x-data="{ showmenu: false }" class="bg-none" >
    <div id="navbar" class="container mx-auto p-2 flex flex-row justify-between items-center">
        <div id="logo" class="">
            <a href="#" class="w-40 block">
                <img src="/public/Logo-white.svg" alt="logo">
              </a>
        </div>
        <nav id="desktopmenu" class="hidden lg:block">
            <ul class="flex flex-row gap-4 font-paragraf font-semibold text-xl text-white items-center">
                <!-- <Text><Link href="/komponentbibliotek" variant="primary" size="small">Komponentbibliotek</Link></Text> -->
                <Text><Link href="#section2" variant="primary" size="small">Minas historie</Link></Text>
                <Text><Link href="#section9" variant="primary" size="small">Afghanistans historie</Link></Text>
                <Text><Link href="#section12" variant="primary" size="small">ADF & vores arbejde</Link></Text>
                <Text><Link href="#section21" variant="primary" size="small">Sådan støtter du</Link></Text>
                <a href="#section22"><Button variant="primary"size="medium">Støt nu</Button></a>
                <MusicToggle />
            </ul>
        </nav>
        <button id="burgermenu" class="lg:hidden" x-on:click="showmenu = ! showmenu"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" class="size-8">
  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
</svg>
</button>
    </div>
    <nav id="mobilmenu" class="flex flex-col content-center" 
    x-show="showmenu" x-transition x-on:click="showmenu = false" x-on:click.outside="showmenu = false">
        <ul class="bg-white pt-4 rounded-md drop-shadow-md">
            <Text><Link href="#section2" variant="secondary" size="small" color="black">Minas historie</Link></Text>
                <Text><Link href="#section9" variant="secondary" size="small" color="black">Afghanistans historie</Link></Text>
                <Text><Link href="#section12" variant="secondary" size="small" color="black">ADF & vores arbejde</Link></Text>
                <Text><Link href="#section21" variant="secondary" size="small" color="black">Sådan støtter du</Link></Text>
                <section class="grid grid-cols-2 justify-items-center p-4">
                <a href="#section22"><Button variant="primary"size="medium" color="black">Støt nu</Button></a>
                <MusicToggle />
            </section>
        </ul>
    </nav>
</header>
<div class="flex w-fit rounded-full overflow-hidden bg-white shadow-md">
    <!-- ENGANGSSTØTTE -->
    <button 
      id="once-btn"
      class="toggle-btn px-8 py-3 transition-colors duration-200 hover:bg-primary-400 hover:text-white bg-primary-500 font-sans text-white">
      Engangsstøtte
    </button>
  
    <!-- MÅNEDLIG STØTTE -->
    <button 
      id="monthly-btn"
      class="toggle-btn px-8 py-3 transition-colors duration-200 hover:bg-primary-400 hover:text-white bg-white text-primary-500">
      Månedlig støtte
    </button>
  </div>
  
  <script>
    const onceBtn = document.getElementById("once-btn");
    const monthlyBtn = document.getElementById("monthly-btn");
  
    function activate(button) {
      if (button === "once") {
        onceBtn.classList.add("bg-primary-500", "text-white");
        onceBtn.classList.remove("bg-white", "text-primary-500");
  
        monthlyBtn.classList.add("bg-white", "text-primary-500");
        monthlyBtn.classList.remove("bg-primary-500", "text-white");
      } else {
        monthlyBtn.classList.add("bg-primary-500", "text-white");
        monthlyBtn.classList.remove("bg-white", "text-primary-500");
  
        onceBtn.classList.add("bg-white", "text-primary-500");
        onceBtn.classList.remove("bg-primary-500", "text-white");
      }
    }
  
    onceBtn.addEventListener("click", () => activate("once"));
    monthlyBtn.addEventListener("click", () => activate("monthly"));
  </script>
  
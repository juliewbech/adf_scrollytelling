---
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";

const { url="", cardimage="", cardimagealt="", cardtitel="", cardbuttontekst=""
 } = Astro.props;
---

<div class="p-8">
    <div 
      class="group relative shadow-xl rounded-xl overflow-hidden h-100 bg-cover bg-center"
      style={`background-image: url('${cardimage}')`}
    >
  
      <!-- ONLY the overlay has blur -->
      <div class="hover:hidden absolute inset-0 bg-black/50  z-10 
                  transition-all duration-500 
                  group-hover:bg-transparent group-hover:backdrop-blur-0">
      </div>
  
      <!-- Button -->
      <div class="absolute inset-0 flex items-end p-4 justify-center z-20 font-header text-center ">
        <a class="transition delay-150 duration-200 ease-in-out hover:-translate-y-1" href={url} target="_blank">
          {cardbuttontekst}
        </a>
      </div>
  
    </div>
  </div>
  
  <style>
    a {
      background-color: #6a9b71;
      color: white;
      padding: 12px 24px;
      border-radius: 30px;
      text-decoration: none;
      display: inline-block;
    }

    :hover a {
      background-color: #7fb887;
    }

    :focus a {
      background-color: #446649;
    }
  </style>
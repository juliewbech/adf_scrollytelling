---
import Button from "../components/Button.astro";
import Text from "../components/Text.astro";
---

<div
  class="items-center justify-center overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px]"
>
  <div
    class="justify-center text-white z-[1] opacity-90 rounded-xl inset-0.5"
  >
  <Text teksttype="brødtekst">
    Progress-bar
    </Text>
    <Text teksttype="brødtekst">
       Toogle
        </Text>
    <Text teksttype="brødtekst">
        250 kr. = undervisning og skolematerialer til en pige i et år  
    </Text>
    <section class="grid grid-cols-2 gap-2">
  <Button variant="primary" size="medium">50 kr.</Button>
  <Button variant="primary" size="medium">100 kr.</Button>
</section>
<section class="grid grid-cols-2 gap-2">
    <Button variant="primary" size="medium">250 kr.</Button>
    <Button variant="primary" size="medium">400 kr.</Button>
  </section>
  </div>
  <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
</div>

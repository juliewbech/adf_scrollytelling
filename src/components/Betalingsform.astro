---
import Button from "../components/Button.astro";
import Text from "../components/Text.astro";
import Textinput from "../components/Textinput.astro";
import SwitchToggle from "../components/SwitchToggle.astro";
import Heading from "../components/Heading.astro";
---

<section class="pt-8">
<!-- STEP 1 BETALINGSFORM -->
<section id="step1" class="flex flex-col items-center justify-center gap-4 p-4 w-full max-w-xl">
  <div class="flex flex-col items-center justify-center overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-8">
    <div class="flex flex-col items-center justify-center text-white z-[1] opacity-90 rounded-xl inset-0.5 gap-4 text-center">
      <progress class="progress w-full rounded-full my-progress" value="25" max="100"></progress>

      <SwitchToggle />

      <Text teksttype="brødtekst" font="sans" color="white">
        250 kr. = undervisning og skolematerialer til en pige i et år
      </Text>

      <section class="grid grid-cols-2 gap-8 justify-items-center">
        <Button variant="tertiary" size="xlarge" onclick="selectAmount(50)">50 kr.</Button>
        <Button variant="tertiary" size="xlarge" onclick="selectAmount(100)">100 kr.</Button>
      </section>

      <section class="grid grid-cols-2 gap-8 pt-4 justify-items-center">
        <Button variant="tertiary" size="xlarge" onclick="selectAmount(250)">250 kr.</Button>
        <Button variant="tertiary" size="xlarge" onclick="selectAmount(400)">400 kr.</Button>
      </section>

      <div class="pt-4 w-sm">
      <input class="w-full" placeholder="Andet beløb">
    </div>
    </div>

    <div class="flex justify-end w-full mt-8">
      <button id="buttonforward" type="button" value="testknap" onclick="goStep1Forward()">
        <svg
  class="w-5 h-5"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M10.5 4.5 18 12m0 0-7.5 7.5M18 12H3"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>

      </button>
    </div>

    <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
  </div>
</section>

<!-- STEP 2 BETALINGSFORM / PRIVATBETALING-->
<section id="step2" style="display: none;" class="flex flex-col items-center justify-center gap-4 p-4 w-full max-w-xl">
  <div class="overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-8 w-full max-w-xl">
    <div class="text-black z-[1] opacity-90 rounded-xl inset-0.5 gap-8 text-center">
      <progress class="progress w-full rounded-full my-progress" value="50" max="100"></progress>

      <Text teksttype="brødtekst" font="serif" color="white">
        Tak fordi du vil støtte afghanske piger!
      </Text>
      <div class="pb-4">
        <p class="text-start font-paragraf text-white pb-1 text-lg">Navn</p>
      <input class="w-full font-paragraf" placeholder="Fornavn">
      </div>
      <input class="w-full" placeholder="Efternavn">
      <p class="text-start font-paragraf text-white pt-3 pb-1 text-lg">Kontaktoplysninger</p>
      <section class="flex justify-between w-full gap-4">
        <input class="w-full" placeholder="E-mail">
        <input class="w-full" placeholder="Tlf. nr.">
    </section>

    <div class="pt-2 text-start">
      <input id="businessCheckbox" type="checkbox" class="checkbox" onclick="goStep2Forward()"/>
      <label for="businessCheckbox" class=" text-white font-paragraf text-sm">Jeg betaler på vegne af en virksomhed</label>
    </div>

      <div class="flex justify-between w-full mt-8">
        <button id="buttonback" type="button" value="testknap" onclick="goStep2Back()">
          <svg
  class="w-5 h-5"
  stroke="black"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M13.5 4.5 6 12m0 0 7.5 7.5M6 12h15"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>
        </button>
        <button id="buttonforward" type="button" value="testknap" onclick="goStep2Forward()">
          <svg
  class="w-5 h-5"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M10.5 4.5 18 12m0 0-7.5 7.5M18 12H3"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>
        </button>
      </div>
    </div>

    <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
  </div>
</section>

<!-- STEP 2 BETALINGSFORM / BUISNESS -->
<section id="step2Business" style="display: none;" class="flex flex-col items-center justify-center gap-4 p-4 w-full max-w-xl">
  <div class="overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-8 w-full max-w-xl">
    <div class="text-black z-[1] opacity-90 rounded-xl inset-0.5 gap-8 text-center">
      <progress class="progress w-full rounded-full my-progress" value="50" max="100"></progress>

      <Text teksttype="brødtekst" font="serif" color="white">
        Tak fordi du vil støtte afghanske piger!
      </Text>
      <div class="pb-4">
        <p class="text-start font-paragraf text-white pb-1 text-lg">Navn</p>
      <input class="w-full" placeholder="Fornavn">
      </div>
      <input class="w-full" placeholder="Efternavn">
      <p class="text-start font-paragraf text-white pt-3 pb-1 text-lg">Kontaktoplysninger</p>
      <section class="flex justify-between w-full gap-4">
        <input class="w-full" placeholder="E-mail">
        <input class="w-full" placeholder="Tlf. nr.">
    </section>

    <div class="my-4 text-start ">
      <input id="businessCheckbox" type="checkbox" class="checkbox" checked="checked" onclick="goStep2BusinessForward()"/>
      <label for="businessCheckbox" class=" text-white font-paragraf text-sm">Jeg betaler på vegne af en virksomhed</label>
    </div>

    <section class="flex justify-between w-full gap-4">
      <input class="w-full" placeholder="Virksomhedsnavn">
      <input class="w-full" placeholder="CVR-nummer">
  </section>
    <input class="w-full my-4" placeholder="Land">
    <input class="w-full mb-4" placeholder="Adresse">
    <section class="flex justify-between w-full mb-4 gap-4">
      <input class="w-full" placeholder="By">
      <input class="w-full" placeholder="Postnummer">
  </section>

  <div class="my-4 text-sm text-start">
    <input id="businessCheckbox" type="checkbox" class="checkbox" />
    <label for="businessCheckbox" class=" text-white font-paragraf text-start">Jeg har læst og accepteret abonnementsbetingelserne</label>
  </div>

      <div class="flex justify-between w-full mt-8">
        <button id="buttonback" type="button" value="testknap" onclick="goStep2BusinessBack()">
          <svg
  class="w-5 h-5"
  stroke="black"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M13.5 4.5 6 12m0 0 7.5 7.5M6 12h15"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>

        </button>
        <button id="buttonforward" type="button" value="testknap" onclick="goStep2BusinessForward()">
          <svg
  class="w-5 h-5"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M10.5 4.5 18 12m0 0-7.5 7.5M18 12H3"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>
        </button>
      </div>
    </div>

    <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
  </div>
</section>

<!-- STEP 3 BETALINGSFORM -->
<section id="step3" style="display: none;" class="flex flex-col items-center justify-center gap-4 p-4 w-full max-w-xl">
  <div class="overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-8 w-full max-w-xl">
    <div class="text-black z-[1] opacity-90 rounded-xl inset-0.5 gap-8 text-center">
      <progress class="progress w-full rounded-full my-progress" value="50" max="100"></progress>

      <Text teksttype="brødtekst" font="serif" color="white">
        Tak fordi du vil støtte afghanske piger!
      </Text>
      <div class="my-4 text-start ">
        <input id="businessCheckbox" type="checkbox" class="checkbox" checked="checked"/>
        <label for="businessCheckbox" class=" text-white font-paragraf text-sm">Betalingskort</label>
      </div>

      <div class="pb-1">
        <p class="text-start font-paragraf text-white pb-1 text-lg">Kortnummer</p>
      <input class="w-full" placeholder="1234 1234 1234 1234">
      </div>
      <section class="flex justify-between w-full gap-4">
        <div>
        <p class="text-start font-paragraf text-white pt-3 pb-1 text-lg">Udløbsdato</p>
        <input class="w-full" placeholder="MM/ÅÅ">
      </div>
      <div>
        <p class="text-start font-paragraf text-white pt-3 pb-1 text-lg">CVV</p>
        <input class="w-full" placeholder="3-cifret kode">
      </div>
    </section>


  <div class="my-4 text-start">
    <input id="businessCheckbox" type="checkbox" class="checkbox" />
    <label for="businessCheckbox" class=" text-white font-paragraf">Mobilepay</label>
  </div>

      <div class="flex justify-between w-full mt-8">
        <button id="buttonback" type="button" value="testknap" onclick="goStep3Back()"><svg
          class="w-5 h-5"
          stroke="black"
          stroke-width="2"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M13.5 4.5 6 12m0 0 7.5 7.5M6 12h15"
            stroke-linejoin="round"
            stroke-linecap="round"
          ></path>
        </svg>
        </button>
        <button id="buttonforward" type="button" value="testknap" onclick="goStep3Forward()">
          <svg
  class="w-5 h-5"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M10.5 4.5 18 12m0 0-7.5 7.5M18 12H3"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
</svg>
        </button>
      </div>
    </div>

    <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
  </div>
</section>

<!-- STEP 4 BETALINGSFORM -->
<section id="step4" style="display: none;" class="flex flex-col items-center justify-center gap-4 p-4">
  <div class="relative items-center justify-center overflow-hidden rounded-[1.5em] border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-8 w-full max-w-xl">
    <div class="flex flex-col items-center justify-center text-white z-[1] opacity-90 rounded-xl inset-0.5 gap-4 text-center">
      <progress class="progress w-full rounded-full my-progress" value="100" max="100"></progress>
      <Heading htmlheading="h2" size="medium" font="serif">Tak for din støtte!</Heading>

<div class="pt-4">
  <svg
  class="w-15 h-15"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="#b9534b"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M4.8 8.1c0-2.3 1.9-4.1 4.1-4.1 1.6 0 3 .9 3.8 2.2 0.8-1.3 2.2-2.2 3.8-2.2 2.3 0 4.1 1.9 4.1 4.1 0 5.3-7.9 10.2-7.9 10.2S4.8 13.4 4.8 8.1z"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

</div>

      <Text teksttype="brødtekst" font="sans" color="white">
        På grund af dig kan afghanske pigers drømme gå i opfyldelse
      </Text>

      <div class="flex justify-start w-full mt-8">
        <button id="buttonback" type="button" value="testknap" onclick="goStep4Back()"><svg
          class="w-5 h-5"
          stroke="black"
          stroke-width="2"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M13.5 4.5 6 12m0 0 7.5 7.5M6 12h15"
            stroke-linejoin="round"
            stroke-linecap="round"
          ></path>
        </svg>
        </button>
      </div>
    </div>

    <div class="absolute w-56 h-48 bg-white blur-[50px] -left-1/2 -top-1/2"></div>
  </div>
</section>
</section>

<style>
.my-progress::-moz-progress-bar {
  background-color: #B9534B; /* DIN FARVE */
  border-radius: 100px;
}

#buttonforward {
  background-color: #B9534B;
  color: white;
  padding: 20px 20px;
  border: none;
  border-radius: 30px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

#buttonforward:hover {
  background-color: #d96f67;
  color: #B9534B;
  transform: translateY(-4px); 
}

#buttonforward:focus {
  background-color: #96423b;
}

#buttonback {
  background-color: #CCCCCC;
  padding: 20px 20px;
  border: none;
  border-radius: 30px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

#buttonback:hover {
  background-color: #E5E5E5;
  transform: translateY(-4px); 
}

#buttonback:focus {
  background-color: #B6B6B6;
}

input{
  padding: 10px;
  border-radius: 8px;
  border: none;
  box-shadow: 4px;
  text: #CFCFCF;
  font-family: 'Paragraf', sans-serif;
}

input:focus{
  border: 2px solid #B9534B;
}



</style>

<script is:inline>
  let selectedAmount = null;
  
  function selectAmount(amount) {
    selectedAmount = amount;
    console.log("Valgt beløb:", selectedAmount);
  }
  
  // Step 1 → Step 2 privat
  function goStep1Forward() {
    console.log("test");
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'flex';
  }
  
  // Step 2 privat → Step1
  function goStep2Back() {
    document.getElementById('step2').style.display = 'none';
    document.getElementById('step1').style.display = 'flex';
  }
  
  // Step 2 privat → Step 3 eller Step 2Business
  function goStep2Forward() {
    if (document.getElementById('businessCheckbox').checked) {
      document.getElementById('step2').style.display = 'none';
      document.getElementById('step2Business').style.display = 'flex';
    } else {
      document.getElementById('step2').style.display = 'none';
      document.getElementById('step3').style.display = 'flex';
    }
  }
  
  // Step 2Business → Step 2 privat
  function goStep2BusinessBack() {
    document.getElementById('step2Business').style.display = 'none';
    document.getElementById('step2').style.display = 'flex';
  }
  
  // Step 2Business → Step 3
  function goStep2BusinessForward() {
    document.getElementById('step2Business').style.display = 'none';
    document.getElementById('step3').style.display = 'flex';
  }
  
  // Step 3 → Step 2 eller Step 2Business
  function goStep3Back() {
    document.getElementById('step3').style.display = 'none';
    if (document.getElementById('businessCheckbox') && document.getElementById('businessCheckbox').checked) {
      document.getElementById('step2Business').style.display = 'flex';
    } else {
      document.getElementById('step2').style.display = 'flex';
    }
  }
  
  // Step 3 → Step 4
  function goStep3Forward() {
    document.getElementById('step3').style.display = 'none';
    document.getElementById('step4').style.display = 'flex';
  }
  
  // Step 4 → Step 3
  function goStep4Back() {
    document.getElementById('step4').style.display = 'none';
    document.getElementById('step3').style.display = 'flex';
  }
  </script>
  
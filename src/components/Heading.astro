---
import { color } from "motion";

// Henter parametrene fra Astro.props
const { htmlheading="h2", size="medium", font="header", color=""} = Astro.props; 
const Htmlheading = htmlheading;
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige størrelser.
const sizeClasses = {
"large": "text-3xl lg:text-6xl font-semibold",
"medium": "text-2xl lg:text-3xl",
"small": "text-xl",
};

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige skrifttyper.
const fontClasses = {
"sans": "font-paragraf",
"serif": "font-header",
};

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige skrifttyper.
const stylingClasses = {
"white": "text-white",
"black": "text-black",
};


---
<Htmlheading class:list={[stylingClasses[color], sizeClasses[size], fontClasses[font]]}><slot /></Htmlheading>
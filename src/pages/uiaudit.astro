---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Header from "../components/Header.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import FacebookPost from "../components/FacebookPost.astro";
import Betalingsform from "../components/Betalingsform.astro";
---

<Heading htmlheading="h1" size="large" font="serif" color="black">UI Audit</Heading>


<Heading htmlheading="h1" size="large" font="serif" color="black">Heading</Heading>
        <Heading htmlheading="h1" size="large" font="serif" color="white">Afghanske piger</Heading>
        <Heading htmlheading="h1" size="large" font="serif" color="white">fratages ret til uddannelse</Heading>


<Heading htmlheading="h1" size="large" font="serif" color="black">Button</Heading>
        <Button variant="primary"size="large">Støt nu</Button>
        <a href="#section1" class="animate-bounce hover:animate-none justify-center flex flex-col items-center gap-4">
        <Text teksttype="konsultativ" font="sans" color="white"> Dyk ned i Minas historie </Text>
        <button class="cursor-pointer rounded-full border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] xs:p-4 md:p-6 tracking-wider shadow-xl"
        ><svg
          class="w-5 h-5"
          stroke="white"
          stroke-width="2"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
                d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
                stroke-linejoin="round"
                stroke-linecap="round"
          ></path>
        </svg>
        </button></a>
        <button @click="playPause()"class="p-3 rounded-full bg-black/30 backdrop-blur-md border border-white/40 shadow-lg hover:bg-black/40 transition"
		>
			<!-- PLAY ikon -->
			<svg x-show="!playing"
				class="w-7 h-7"
				stroke="white"
				stroke-width="1"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<polygon points="6,4 20,12 6,20"/>
			</svg>
	
			<!-- PAUSE ikon -->
			<svg x-show="playing"
				class="w-7 h-7"
				stroke="white"
				stroke-width="1"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<rect x="6" y="4" width="4" height="16"/>
				<rect x="14" y="4" width="4" height="16"/>
			</svg>
	
		</button>
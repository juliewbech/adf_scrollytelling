<script>
	/* Import af Motion One bibliotek */
	import { animate, stagger, inView, scroll } from "motion";

	/* Horisontal scroll sektion */
		scroll(
	animate("#horisontalliste", {
		transform: ["none", "translateX(-1000vw)"]
	}),
	{ target: document.querySelector("#horisontalscrollsection") }
	); 

	// Scroll zoom effekt
	scroll(
    animate(".scrollzoomimg", { 
        scale: [1, 1.5]    
    }),
    { 
      target: document.querySelector(".scrollzoom"),
      offset: ["0.50 end", "end end"]
    }
    )

	// Stagger animation sektion med tal
inView("#stagger", () => {
  animate(
    ".staggeranimation",
    { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
    {
      duration: 0.9,
      delay: stagger(0.3, { startDelay: 0.1 })
    }
  );
});

/* Crossfade to billeder */
scroll(
	animate(".crossfadebottomimg", {
		opacity: [1, 0]
	}), {
		target: document.querySelector(".crossfadeimages"),
		offset: ["-25vh", "25vh"]
	}
	);
	
	scroll(
	animate(".crossfadebottomimg2", {
		opacity: [1, 0]
	}), {
		target: document.querySelector(".crossfadeimages2"),
		offset: ["-25vh", "25vh"]
	}
	);

	scroll(
	animate(".crossfadebottomimg3", {
		opacity: [1, 0]
	}), {
		target: document.querySelector(".crossfadeimages3"),
		offset: ["-25vh", "25vh"]
	}
	);


	/*Progress-baren/læseindikatoren */
	scroll( animate(".progress-bar", { scaleX: [0, 1] }));


	// Fade up animation
	inView(".fadeUp", () => {
  animate(".fadeUp", 
    { 
      opacity: [0, 1],
      y: [50, 0] 
    }, 
    { 
      duration: 1.5, 
      easing: "ease-out"
    }
  )
})

	</script>

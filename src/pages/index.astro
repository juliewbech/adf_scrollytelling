---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Header from "../components/Header.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import FacebookPost from "../components/FacebookPost.astro";
import Betalingsform from "../components/Betalingsform.astro";
---
<MainLayout title="Hendes fremtid - Afghan Daanish Foundation">
<body>
	<main>
		<div
		x-data="{
			playing: false,
			fadeDuration: 2000,
		
			playPause() {
				const audio = this.$refs.trykforatafspillelyd;
				if (!audio) return;
		
				if (!this.playing) {
					audio.volume = 0;
					audio.play();
					this.playing = true;
		
					// Fade-in
					const steps = 20;
					const stepTime = this.fadeDuration / steps;
					let v = 0;
					let interval = setInterval(() => {
						v += 1 / steps;
						audio.volume = Math.min(v, 1);
						if (v >= 1) clearInterval(interval);
					}, stepTime);
		
				} else {
					audio.pause();
					this.playing = false;
				}
			}
		}"
	>
	
	

	<!-- HERO SECTION -->
	<section id="hero-section">
			<div class="hero min-h-screen relative overflow-hidden">
			  
			  {/* Video baggrund */}
			  <video
				autoPlay
				muted
				loop
				playsInline
				class="absolute w-full h-full object-cover z-0"
			  >
				<source src="https://i.imgur.com/0uEsG1Q.mp4" type="video/mp4" />

---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Tidslinje from "../components/Tidslinje.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
---
<MainLayout title="Afghan Daanish Foundation - kampagneside">
	<body>
	<main>

		<!-- HERO-SECTION -->
		<section>
			<div class="hero min-h-screen relative overflow-hidden">
			  
			  {/* Video baggrund */}
			  <video
				autoPlay
				muted
				loop
				playsInline
				class="absolute w-full h-full object-cover z-0"
			  >
				<source src="https://i.imgur.com/0uEsG1Q.mp4" type="video/mp4" />
				Din browser understøtter ikke HTML5 video.
			  </video>
		  
			  {/* Header placeres absolut */}
			  <div class="fixed top-2 p-2 w-full z-50">
			  </div>
		  
			  {/* Overlay */}
			  <div class="absolute w-full h-full bg-black opacity-30 z-10"></div>
			
		  
			  {/* Content */}
			  <div class="hero-content text-neutral-content text-center z-20 relative">
				<div>
				  <Heading htmlheading="h1">HØJSKOLE I UDLANDET!</Heading>
				<Text teksttype="brødtekst">Eventyr, selvudvikling & fællesskab</Text>
				  <Button variant="primary" size="medium">
					<a href="/travelform">STØT</a>
				  </Button>
				</div>
			  </div>
			</div>
		  </section>


---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Header from "../components/Header.astro";
import Tidslinje from "../components/Tidslinje.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import FacebookPost from "../components/FacebookPost.astro";
import Betalingsform from "../components/Betalingsform.astro";
---
<MainLayout title="Afghan Daanish Foundation - kampagneside">
	<body>
	<main>

		<section>
			<div class="hero min-h-screen relative overflow-hidden">
			  
			  {/* Video baggrund */}
			  <video
				autoPlay
				muted
				loop
				playsInline
				class="absolute w-full h-full object-cover z-0"
			  >
				<source src="https://i.imgur.com/0uEsG1Q.mp4" type="video/mp4" />
				Din browser understøtter ikke HTML5 video.
			  </video>
		  
			  {/* Header placeres absolut */}
			  <div class="absolute top-2 p-2 w-full z-50">
		<div class="progress-bar h-4 fixed w-full bg-primary-600 left-0 origin-top-left top-0 right-0"></div>

				<Header></Header>
			  </div>
		  
			  {/* Overlay */}
			  <div class="absolute w-full h-full bg-black opacity-50 z-10"></div>
			
		  
			  {/* Content */}
			  <div class="hero-content text-neutral-content top-115 z-20 p-8 relative">
				<div>
					<Heading htmlheading="h1" size="large" font="serif" color="white">Afghanske pigers</Heading>
					<Heading htmlheading="h1" size="large" font="serif" color="white">forbud om uddannelse</Heading>
					<Heading htmlheading="h2" size="small" font="serif" color="white">af Afghan Daanish Foundation</Heading>
				</div>
			</div>
			<div class="absolute bottom-10 z-20 w-full flex justify-center">
	
<a href="#section1"><button
class="cursor-pointer rounded-full border-[1px] border-[#ffffffaa] bg-[#8988885c] backdrop-blur-[6px] p-6 tracking-wider shadow-xl animate-bounce hover:animate-none"
>
<svg
  class="w-5 h-5"
  stroke="white"
  stroke-width="2"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
	d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
	stroke-linejoin="round"
	stroke-linecap="round"
  ></path>
</svg>
</button></a>

		</div>
			</div>
		  </section>

		  <article id="section1">
		  <section class="scrollzoom overflow-clip">
				<img src="https://i.imgur.com/1wxy7cZ.png" class="scrollzoomimg w-full" alt="">
			</section> 
		</article>

	<!-- SECTION 1 -->
	<article>
		<div class="sticky top-0 left-0 right-0 bottom-0 h-screen w-full bg-cover bg-center" style="background-image: url('https://i.imgur.com/7z6EyAx.png')" ><!-- sticky elementet med lidt ekstra indhold -->
			<div class="flex justify-start h-full">
				<div class="flex flex-col w-full md:w-1/2  justify-center gap-4 p-4 ">
					<div class="">
						<img src="" alt="">
					</div>
					<div class="bg-slate-100">
						<img src="" alt="">
					</div>
				</div>
			</div>
		</div>

	<!-- SECTION 2 -->
		<div class="relative flex justify-end">
			<div class="flex flex-col w-full md:w-1/2 h-full justify-center gap-200
			 p-4">
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mød Mina. En helt almindelig afghansk pige på 13 år.
						</Text>
				</div>
				<div class="bg-slate-100 text-center py-2 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina er bosiddende i Mashhad i Razavi Khorasan-provinsen i Iran.
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Ligesom mange andre afghanere flyttede hendes familie til Iran for at skabe sig en bedre tilværelse tilbage i 1980, efter at Sovjetunionen invaderede Afghanistan.
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina ser Iran som sit hjem. Her er hun født og opvokset. 
						Her har hun sine venner og tætteste familie. 
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina går i også i skole, som hun elsker. Hun drømmer om 
						at læse medicin en dag, så hun kan blive læge og hjælpe
						mennesker i nød.
						</Text>
				</div>
			</div>
		</div>
		<div class="h-[100vh]"></div>
	</article>

	<!-- SECTION 3 -->
	<div class="flex items-center h-screen w-full bg-cover bg-center bg-primary-500" >
		<p class="w-3/4 lg:w-1/2 mx-auto p-10 bg-white text-xl sticky rounded-3xl drop-shadow-md font-paragraf text-center top-1/4">Men en dag ændrede alt sig...</p>
	</div>

	<!-- SECTION 4 -->
	<article>
		<div class="sticky top-0 left-0 right-0 bottom-0 h-screen w-full bg-cover bg-center" style="background-image: url('https://i.imgur.com/dnM7IoN.png')" ><!-- sticky elementet med lidt ekstra indhold -->
			<div class="flex justify-end h-full">
				<div class="flex flex-col w-full md:w-1/2  justify-center gap-4 p-4 ">
					<div class="bg-slate-100">
						<img src="" alt="">
					</div>
					<div class="bg-slate-100">
						<img src="" alt="">
					</div>
				</div>
			</div>
		</div>
		<div class="relative flex justify-start">
			<div class="flex flex-col w-full md:w-1/2 h-full justify-center gap-8
			 p-4">
			 <div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
				<Text teksttype="brødtekst">
					I sommeren 2025 annoncerede Iran at alle afghanere
					skulle hjemsendes til Afghanistan. 
					</Text>
			</div>
			<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
				<Text teksttype="brødtekst">
					Mina, hendes 7 søskende og forældre blev tvangsudsendt
					d. 24 juni 2025
					</Text>
			</div>
			<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
				<Text teksttype="brødtekst">
					Tvangsudsendt til en land, hvor hun har rødder, men ingen kendskab.
					</Text>
			</div>
			<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
				<Text teksttype="brødtekst">
					Tvagsudsendt til at land, som hendes forældre desperat flygtede fra for over 40 år siden.
					</Text>
			</div>
			</div>
		</div>
		<div class="h-[100vh]"></div>
	</article>

	<!-- SECTION 5 -->
	<div class="flex items-center h-screen w-full bg-cover bg-center bg-black" >
		<p class="w-3/4 lg:w-1/2 mx-auto p-10 bg-white text-xl sticky rounded-3xl drop-shadow-md font-paragraf text-center top-1/4">Men hvad var det egentlig at familien flyttede til?</p>
	</div>

	<!-- SECTION 6 -->
		<article>
			<div class="sticky top-0 left-0 right-0 bottom-0 h-screen w-full bg-cover bg-center" style="background-image: url('https://i.imgur.com/8xSy15c.png')" ><!-- sticky elementet med lidt ekstra indhold -->
				<div class="flex justify-start h-full">
					<div class="flex flex-col w-full md:w-1/2  justify-center gap-4 p-4 ">
						<!-- <div class="bg-slate-100">
							<img src="https://i.imgur.com/VEhXUgB.jpeg" alt="">
						</div>
						<div class="bg-slate-100">
							<img src="https://i.imgur.com/VEhXUgB.jpeg" alt="">
						</div> -->
					</div>
				</div>
			</div>
			<div class="relative flex justify-end">
				<div class="flex flex-col w-full md:w-1/2 h-full justify-center gap-8
				 p-4">
				 <div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Tvagsudsendt til at land, som hendes forældre desperat flygtede fra for over 40 år siden.
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina og hendes familie så ingen anden udvej end at flytte 
						til den kigshærgede hovedstad Kabul, som er stærkt 
						præget af fattigdom.
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Tilbage i 2021 overtog den islamistiske bevægelse Taliban 
						igen magten efter 20 år med oprør mod den daværende 
						regering og internationale styrker.
						</Text>
				</div>
				<div class="bg-slate-100 text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Taliban var hurtige til at indføre lovkrav, som ville komme til at 
						påvirke afghanernes hverdag
						</Text>
				</div>
				</div>
			</div>
			<div class="h-[100vh]"></div>
		</article>

	<!-- SECTION 7 -->
	<div class="flex items-center h-screen w-full bg-cover bg-center bg-black" >
		<p class="w-3/4 lg:w-1/2 mx-auto p-10 bg-white text-xl sticky rounded-3xl drop-shadow-md font-paragraf text-center top-1/4">... men særligt hverdagen for de piger og kvinder.</p>
	</div>

	<!-- SECTION 8 -->
		<article>
			<div class="sticky top-0 left-0 right-0 bottom-0 h-screen w-full bg-cover bg-center" style="background-image: url('https://i.imgur.com/pJLzTeo.png')" ><!-- sticky elementet med lidt ekstra indhold -->
				<div class="flex justify-start h-full">
					<div class="flex flex-col w-full md:w-1/2  justify-center gap-4 p-4 ">
						<!-- <div class="bg-slate-100">
							<img src="https://i.imgur.com/VEhXUgB.jpeg" alt="">
						</div>
						<div class="bg-slate-100">
							<img src="https://i.imgur.com/VEhXUgB.jpeg" alt="">
						</div> -->
					</div>
				</div>
			</div>
			<div class="relative flex justify-end">
				<div class="flex flex-col w-full md:w-1/2 h-full justify-center gap-8
				 p-4">
				 <div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Det betyder, at Mina nu skal være fuldt tildækket i en 
						mørk niqab offentligheden.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina må ikke gå uden for en dør uden en mandlig ledsager.
						</Text>
				</div> 
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina må ikke rejse inden- eller udenrigs, uden en mand 
						og en skriftlig legitim grund.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina må ikke besøge parker, fitnesscentre, 
						skønhedssaloner eller historiske monumenter.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina må ikke tale, synge, danse eller grine i det offentlige rum.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Vinduerne fra Minas værelse skal tildækkes i bygninger, der vender ud mod offentligheden.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Og Mina må ikke gå i skole eller studere da hun er over 12 år og over grundskolealderen.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Hun kan risikere at straffes med piskeslag og stening,
						hvis hun bryder nogle af disse regler.
						</Text>
				</div>
				<div class="bg-primary-600 text-white text-center p-1 rounded-3xl drop-shadow-md">
					<Text teksttype="brødtekst">
						Mina må give afkald på hendes frihed og hendes drøm
						om at blive læge.
						</Text>
				</div>
				</div>
			</div>
			<div class="h-[100vh]"></div>
		</article>

	<!-- SECTION 9 -->
		 <div class="bg-white p-8">
			<Heading htmlheading="h2" size="large" font="serif" color="black">Afghanistan de sidste 30 år</Heading>
		 </div>

		 <div class="overflow-clip bg-white">
			<section id="horisontalscrollsection" class="h-[1000vw]">
				<ul id="horisontalliste" class="list-none pl-0 flex sticky top-[10vh]">
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/OC40RIF.png" alt="Sovjetiske tropper i Afghanistan">
							<div class="pl-4">
								<Heading htmlheading="h2" size="large" font="serif" color="red">1979</Heading>
								<Heading htmlheading="h2" size="medium" font="serif" color="black">Sovjetunionen invaderer Afghanistan</Heading>
								<Text teksttype="brødtekst" font="serif" color="black">
									Begyndelsen på årtier med konflikt, ustabilitet og millioner af flygtninge.
								</Text>
							</div></figure></li>
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[900px]"><img src="https://i.imgur.com/UXkzMOM.jpeg" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">1996</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Taliban kommer til magten for første gang</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
									Kvinder udelukkes fra uddannelse og arbejde. Strenge religiøse love bliver indført.
									</Text>
							</figcaption></figure></li>
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/mbVdER8.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">11 september 2001</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Terrorangrebene på World Trade Center i USA d. 11 september</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
									USA og allierede invaderer Afghanistan kort efter for at fjerne al-Qaeda og Taliban.
									</Text>
									</figcaption></figure></li>
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/icmhsLA.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
								 	<Heading htmlheading="h2" size="large" font="serif" color="red">Oktober 2001</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Taliban bliver afsat</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										En ny regering dannes med støtte fra internationale styrker. For første gang i årtier får mange piger igen adgang til skole.
									</Text>
									</figcaption></figure></li>
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/OnKWj1h.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">2001–2021</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">To årtier med håb og fremskridt</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										Millioner af piger begynder i skole. Kvinder får stemmer, karrierer og drømme for fremtiden. Men usikkerheden og truslerne mod rettighederne forbliver.
									</Text>
									</figcaption></figure></li>				
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/m4bS3ME.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">Maj 2021</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Angreb på en pigeskole i Kabul</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										Mindst 60 piger dræbt og 200 såret – et brutalt varsel om, hvad der venter.
									</Text>
									</figcaption></figure></li>	
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/uQQ50at.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">August 2021</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Taliban overtager magten igen</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										Den afghanske regering kollapser. Kvinders og pigers rettigheder bliver hurtigt rullet tilbage.
									</Text>
									</figcaption></figure></li>	
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/Ok9RKjN.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">Efteråret 2021</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Taliban forbyder piger at gå i skole efter sjette klasse</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
									Tusindvis af skoler står tomme, og lærere mister deres arbejde.
									</Text>
									</figcaption></figure></li>		
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/k7lSI2b.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">2022</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Nye restriktioner mod kvinder</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										November: kvinder forbydes at arbejde for NGO’er og FN.
										December: kvinder forbydes at gå på universitetet. 
									</Text>
									</figcaption></figure></li>				
					<li class="flex w-[100vw] items-start justify-center flex-col overflow-hidden flex-grow-0 flex-shrink-0 flex-auto">
						<figure class="flex flex-row max-w-[800px]"><img src="https://i.imgur.com/inyizHu.png" alt="Sovjetiske tropper i Afghanistan">
							<figcaption class="pl-4">
									<Heading htmlheading="h2" size="large" font="serif" color="red">August 2024</Heading>
									<Heading htmlheading="h2" size="medium" font="serif" color="black">Taliban forbyder, at kvinders stemmer må høres offentligt</Heading>
									<Text teksttype="brødtekst" font="serif" color="black">
										Selv radio og tv-sendere fjernes, hvis kvinder medvirker. 
									</Text>
									</figcaption></figure></li>		
				</ul>
			</section>
		</div>

		<!-- SECTION 6 -->
		<section class="bg-fffff h-[100vh] mx-auto p-8">
			<div class="pt-40">
			<Heading htmlheading="h2" size="large" font="serif" color="black">Ungdomslæsefærdighed i Afghanistan i 2022</Heading>
		</div>
			<div class="md:pt-6 xs:pt-4">
			<Heading htmlheading="h2" size="medium" font="serif" color="black">Alder 15-24 år</Heading>
		</div>
			<div class="flourish-embed flourish-chart md:pt-10 md:mx-8 xs:pt-10" data-src="visualisation/26180539"><script src="https://public.flourish.studio/resources/embed.js"></script><noscript><img src="https://public.flourish.studio/visualisation/26180539/thumbnail" width="100%" alt="chart visualization" /></noscript></div>
	</section>

		 <!-- SECTION 7 -->
		 <div class="flex items-center h-screen w-full bg-cover bg-center bg-secondary-500" >
			<p class="w-3/4 lg:w-1/2 mx-auto p-10 bg-white md:text-xl sticky rounded-3xl drop-shadow-md font-paragraf text-center top-1/4">Men DU kan være med til at ændre den yngre generation skæbne</p>
		</div>

		  <!-- SECTION 8 -->
		  <article>
			<div class="sticky top-0 left-0 right-0 bottom-0 h-screen w-full bg-cover bg-center" style="background-image: url('https://i.imgur.com/JPq9jcC.jpeg')" ><!-- sticky elementet med lidt ekstra indhold -->
				<div class="flex justify-start h-full">
					<div class="flex flex-col w-full md:w-1/2 md:justify-end md:text-white md:p-8 xs:justify-start xs:text-primary-600 gap-4 p-4 pt-8 ">
						<div class="">
							<Heading htmlheading="h2" size="large" font="serif" color="">Hvem er vi?</Heading>
						</div>

---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Header from "../components/Header.astro";
import Tidslinje from "../components/Tidslinje.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
---
<MainLayout title="Afghan Daanish Foundation - kampagneside">
	<body>
	<main>

		<!-- HERO-SECTION -->
		<section>
			<div class="hero min-h-screen relative overflow-hidden">

				
			  
			  {/* Video baggrund */}
			  <video
				autoPlay
				muted
				loop
				playsInline
				class="absolute w-full h-full object-cover z-0"
			  >
				<source src="https://i.imgur.com/0uEsG1Q.mp4" type="video/mp4" />
				Din browser understøtter ikke HTML5 video.
			  </video>
		  
			  {/* Header placeres absolut */}
			  <div class="absolute top-2 p-2 w-full z-50">
		<!-- <div class="progress-bar h-4 fixed w-full bg-gradient-to-r from-pink-500 to-yellow-300 left-0 origin-top-left top-0 right-0"></div> -->

				<Header></Header>
			  </div>
		  
			  {/* Overlay */}
			  <div class="absolute w-full h-full bg-black opacity-50 z-10"></div>
			
		  
